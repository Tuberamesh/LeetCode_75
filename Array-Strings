// Product of Array Except Self
//time complexity: O(n)
//space complexity: O(1)
class Solution {
    public int[] productExceptSelf(int[] nums) {
        int n=nums.length;
        int left[]=new int[n];
        int right[]=new int[n];
          int ans[]=new int[n];
        

        left[0]=1;
        for(int i=1;i<n;i++){
            left[i]=left[i-1]*nums[i-1];
        }
        right[n-1]=1;
         for(int i=right.length-2;i>-1;i--){
            right[i]=right[i+1]*nums[i+1];
        }

         for(int i=0;i<n;i++){
            ans[i]=left[i]*right[i];
        }
        return ans;
        
    }
}


